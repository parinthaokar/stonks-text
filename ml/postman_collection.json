{
  "info": {
    "name": "Stonks & Texts — Recommendation Engine (Modal)",
    "description": "Assertions against the DEPLOYED Modal API. Covers health, pipeline info, a valid POST (200) and invalid input (422).\n\nbase_url is a collection variable pointing at the deployed Modal URL — never localhost.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://parinthaokar--stonks-recommendation-engine-fastapi-app.modal.run",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
        "description": "Liveness. Returns 503 if the artifact failed to load."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('artifact is loaded', () => pm.expect(b.artifact_loaded).to.eql(true));",
        "pm.test('reports sklearn 1.9.1', () => pm.expect(b.sklearn_version).to.eql('1.9.1'));",
        "pm.test('NOT hitting localhost', () => pm.expect(pm.request.url.getHost()).to.not.include('localhost'));"
      ]}}]
    },
    {
      "name": "2. Pipeline info — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/pipeline", "host": ["{{base_url}}"], "path": ["pipeline"] },
        "description": "The artifact describing itself: steps, build time, sklearn version, custom transformer, feature names, and its measured accuracy."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('three pipeline steps', () => pm.expect(b.steps).to.eql(['features','scaler','classifier']));",
        "pm.test('names the custom transformer', () => pm.expect(b.custom_transformer).to.eql('MarketContextFeatures'));",
        "pm.test('reports built_at', () => pm.expect(b).to.have.property('built_at'));",
        "pm.test('sklearn version matches the build', () => pm.expect(b.sklearn_version).to.eql('1.9.1'));",
        "pm.test('learned state trained on real rows', () => pm.expect(b.n_training_rows).to.be.above(1000));",
        "pm.test('custom transformer expanded the feature space', () => {",
        "  pm.expect(b.engineered_features.length).to.be.above(b.raw_features.length);",
        "});",
        "pm.test('reports its own track record honestly', () => {",
        "  pm.expect(b).to.have.property('beats_baseline');",
        "  pm.expect(b.holdout_accuracy).to.be.a('number');",
        "});"
      ]}}]
    },
    {
      "name": "3. Recommend — valid input — 200",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"pct_change\": -7.4,\n  \"volume_ratio\": 3.1,\n  \"vol_20d\": 48.0,\n  \"ma50_dist\": -12.0,\n  \"drawdown_pct\": 22.0,\n  \"is_52w_high\": 0,\n  \"is_52w_low\": 0,\n  \"down_streak\": 4,\n  \"up_streak\": 0,\n  \"is_crypto\": 0\n}" },
        "url": { "raw": "{{base_url}}/recommend", "host": ["{{base_url}}"], "path": ["recommend"] },
        "description": "A 7.4% drop on 3.1x volume after four red days, 22% off the 52-week high."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('returns one of the three actions', () => {",
        "  pm.expect(['buy','hold','sell']).to.include(b.action);",
        "});",
        "pm.test('confidence is a probability', () => {",
        "  pm.expect(b.confidence).to.be.at.least(0).and.at.most(1);",
        "});",
        "pm.test('probabilities cover all three actions', () => {",
        "  pm.expect(Object.keys(b.probabilities)).to.have.lengthOf(3);",
        "});",
        "pm.test('probabilities sum to 1', () => {",
        "  const t = Object.values(b.probabilities).reduce((a,c) => a + c, 0);",
        "  pm.expect(t).to.be.closeTo(1, 0.01);",
        "});",
        "pm.test('ships its track record with the answer', () => {",
        "  pm.expect(b.track_record).to.have.property('holdout_accuracy');",
        "  pm.expect(b.track_record).to.have.property('majority_baseline');",
        "});",
        "pm.test('fast — artifact loaded once, not per request', () => {",
        "  pm.expect(pm.response.responseTime).to.be.below(3000);",
        "});"
      ]}}]
    },
    {
      "name": "4. Recommend — invalid input — 422",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"pct_change\": 999,\n  \"volume_ratio\": -5,\n  \"vol_20d\": 48.0,\n  \"ma50_dist\": -12.0,\n  \"drawdown_pct\": 22.0,\n  \"is_52w_high\": 7,\n  \"is_52w_low\": 0,\n  \"down_streak\": 900,\n  \"up_streak\": 0,\n  \"is_crypto\": 0\n}" },
        "url": { "raw": "{{base_url}}/recommend", "host": ["{{base_url}}"], "path": ["recommend"] },
        "description": "Four fields out of bounds at once: a 999% move, negative volume, a 900-day streak, and a non-boolean flag. Pydantic must reject all of them before the model is touched."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 422, not 500', () => pm.response.to.have.status(422));",
        "const b = pm.response.json();",
        "pm.test('returns validation detail', () => pm.expect(b.detail).to.be.an('array').that.is.not.empty);",
        "pm.test('flags every out-of-range field', () => {",
        "  const fields = b.detail.map(d => d.loc[d.loc.length - 1]);",
        "  pm.expect(fields).to.include.members(['pct_change','volume_ratio','is_52w_high','down_streak']);",
        "});",
        "pm.test('explains why', () => pm.expect(b.detail[0].msg).to.be.a('string').and.not.empty);"
      ]}}]
    }
  ]
}
